# =============================================================
# SmartWater backend - fichier de variables d'environnement
# =============================================================
# COPIE ce fichier en ".env" (sans ".example") et remplis les
# valeurs avant de lancer le serveur. Ne JAMAIS mettre le
# fichier ".env" reel sur GitHub ou dans un endroit public.
# =============================================================

# --- Environnement (test ou production) ---
# Sert uniquement a t'aider a savoir dans quel environnement tu es
# (affiche dans les logs). Cree un projet Supabase separe pour chaque
# environnement -- voir docs/DEPLOIEMENT.md, Etape 0.
ENVIRONMENT=test

# --- Django ---
# Genere une cle secrete avec: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-moi-avec-une-vraie-cle-secrete
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de donnees (Supabase / PostgreSQL) ---
# Trouve ces infos dans ton projet Supabase :
# Project Settings > Database > Connection string
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=ton-mot-de-passe-supabase
DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432

# --- Supabase Auth (pour verifier les tokens envoyes par l'app) ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=ta-cle-anon-supabase
SUPABASE_SERVICE_ROLE_KEY=ta-cle-service-role-supabase

# --- MQTT (communication avec les ESP32) ---
# Tu peux utiliser un broker gratuit comme HiveMQ Cloud ou EMQX Cloud
MQTT_BROKER_HOST=xxxxxxxxxxxx.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_USERNAME=smartwater
MQTT_PASSWORD=ton-mot-de-passe-mqtt

# --- Meteo (Open-Meteo, gratuit, pas de cle necessaire) ---
# Rien a remplir ici, Open-Meteo ne demande pas de cle API.

# --- Notifications push (Firebase Cloud Messaging) ---
# Va dans la console Firebase > Parametres du projet > Comptes de service
# et telecharge le fichier JSON, mets son chemin ici.
FCM_CREDENTIALS_PATH=./firebase-credentials.json

# --- SMS/USSD (a activer plus tard, en production) ---
# Laisser vide pendant la phase pilote / test.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
